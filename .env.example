# Zoho SMTP credentials for the enquiry form (/api/enquiry).
# Create an app-specific password in Zoho Mail: Settings > Security >
# App Passwords, then add these in Vercel under Project > Settings >
# Environment Variables.
#
# Indian Zoho accounts use smtp.zoho.in; others use smtp.zoho.com.
ZOHO_SMTP_HOST=smtp.zoho.in
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=sales@rovantachem.com
ZOHO_SMTP_PASSWORD=

# Where enquiries are delivered. Defaults to the sales address in site content.
ENQUIRY_TO=sales@rovantachem.com
